# PostgreSQL Database connection url (production pooler vs local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sidequest?schema=public"

# Secret key used to sign HTTP-Only JWT tokens
JWT_SECRET="super-secret-default-signing-key-change-in-production"

# Resend API Key for sending emails (leave blank to fallback to terminal mock logger)
RESEND_API_KEY=""

# Application deploy domain url
NEXT_PUBLIC_APP_URL="http://localhost:3000"
