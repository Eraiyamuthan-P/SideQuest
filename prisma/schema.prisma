datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssignmentMode {
  first_come
  review_select
}

enum TaskStatus {
  OPEN
  ASSIGNED
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReviewRole {
  poster
  doer
}

enum SupportTicketType {
  contact
  feedback
  bug
  dispute
}

enum TaskLocation {
  MENS_HOSTEL      @map("Mens Hostel")
  WOMENS_HOSTEL    @map("Womens Hostel")
  TT               @map("TT")
  LIBRARY          @map("Library")
  SJT              @map("SJT")
  SMV              @map("SMV")
  PRP              @map("PRP")
  MG_BLOCK         @map("MG Block")
  FOODYS           @map("Foodys")
  MAIN_GATE        @map("Main Gate")
}

enum TaskCategory {
  TUTORING          @map("Tutoring")
  FOOD_PICKUP       @map("Food Pickup")
  RIDE_SHARING      @map("Ride Sharing")
  PARCEL_DELIVERY   @map("Parcel Delivery")
  SHOPPING          @map("Shopping")
  CODING_HELP       @map("Coding Help")
  NOTES             @map("Notes")
  PRINTING          @map("Printing")
  HOSTEL_HELP       @map("Hostel Help")
  EVENT_ASSISTANCE  @map("Event Assistance")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  email              String              @unique
  verified           Boolean             @default(false)
  role               Role                @default(STUDENT)
  credits            Int                 @default(0)
  ratingAverage      Float               @default(0)
  ratingCount        Int                 @default(0)
  bio                String?
  hostel_block       String?
  created_at         DateTime            @default(now())
  
  status             AccountStatus       @default(ACTIVE)
  deletedAt          DateTime?
  sessionVersion     Int                 @default(1)
  
  availability       Availability        @default(AVAILABLE)
  skills             String[]            @default([])
  activeChatTaskId   String?
  lastChatActiveAt   DateTime?
  pref_notify_chat        Boolean @default(true)
  pref_notify_applications Boolean @default(true)
  pref_notify_reviews     Boolean @default(true)
  pref_notify_tasks       Boolean @default(true)

  posted_tasks       Task[]              @relation("PostedTasks")
  applications       TaskApplication[]
  received_reviews   Review[]            @relation("ReceivedReviews")
  sent_reviews       Review[]            @relation("SentReviews")
  badges             Badge[]
  messages           Message[]
  support_tickets    SupportTicket[]
  notifications      Notification[]      @relation("NotificationRecipient")
  acted_notifications Notification[]     @relation("NotificationActor")
  saved_tasks        SavedTask[]
  audit_logs         AuditLog[]          @relation("AdminAuditLogs")
}

model VerificationOtp {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String
  expires_at DateTime
  created_at DateTime @default(now())
}

model Task {
  id                  String            @id @default(uuid())
  poster_id           String
  title               String
  description         String
  category            TaskCategory
  photo_url           String?
  offeredAmount       Int
  agreedAmount        Int?
  pendingPaymentSince DateTime?
  deadline            DateTime
  location            TaskLocation
  people_needed       Int               @default(1)
  assignment_mode     AssignmentMode    @default(first_come)
  status              TaskStatus        @default(OPEN)
  created_at          DateTime          @default(now())
  cancellationRequestedBy String?
  isUrgent            Boolean           @default(false)
  estimatedDuration   EstimatedDuration @default(MIN_30)
  isPinned            Boolean           @default(false)
  
  poster              User              @relation("PostedTasks", fields: [poster_id], references: [id], onDelete: Cascade)
  applications        TaskApplication[]
  reviews             Review[]
  messages            Message[]
  saved_by            SavedTask[]
  notifications       Notification[]      @relation("NotificationTask")

  @@index([status])
  @@index([category])
}

model TaskApplication {
  id              String            @id @default(uuid())
  taskId          String
  doerId          String
  requestedAmount Int
  isCounterBid    Boolean
  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now())

  task            Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doer            User              @relation(fields: [doerId], references: [id], onDelete: Cascade)

  @@unique([taskId, doerId])
}

model Review {
  id          String     @id @default(uuid())
  task_id     String
  reviewer_id String
  reviewee_id String
  role        ReviewRole
  rating      Int
  comment     String
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  task        Task       @relation(fields: [task_id], references: [id], onDelete: Cascade)
  reviewer    User       @relation("SentReviews", fields: [reviewer_id], references: [id], onDelete: Cascade)
  reviewee    User       @relation("ReceivedReviews", fields: [reviewee_id], references: [id], onDelete: Cascade)

  @@unique([task_id, reviewer_id])
}

model Badge {
  id         String   @id @default(uuid())
  user_id    String
  badge_type String
  earned_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Message {
  id              String   @id @default(uuid())
  task_id         String
  sender_id       String
  content         String
  attachment_url  String?
  attachment_type String?
  created_at      DateTime @default(now())

  task            Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id         String            @id @default(uuid())
  user_id    String
  type       SupportTicketType
  subject    String
  message    String
  status     String            @default("open")
  priority   String            @default("normal")
  notes      String?
  timeline   Json?
  created_at DateTime          @default(now())

  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum EstimatedDuration {
  MIN_10          @map("10m")
  MIN_30          @map("30m")
  HOUR_1          @map("1h")
  HALF_DAY        @map("half day")
  FULL_DAY        @map("full day")
}

enum Availability {
  AVAILABLE
  BUSY
}

enum NotificationType {
  BID
  ASSIGNMENT
  COMPLETION
  CHAT
  REVIEW
  REJECTION
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  user_id     String
  actorId     String?
  taskId      String?
  title       String
  message     String
  type        NotificationType
  is_read     Boolean          @default(false)
  link        String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  user        User             @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task        Task?            @relation("NotificationTask", fields: [taskId], references: [id], onDelete: Cascade)
}

model SavedTask {
  id         String   @id @default(uuid())
  user_id    String
  task_id    String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([user_id, task_id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actor         User     @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  actorEmail    String
  targetId      String?
  targetEmail   String?
  action        String
  reason        String
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
}

model AdminInvitation {
  id         String    @id @default(uuid())
  email      String    @unique
  role       Role
  invitedBy  String    // Email of the superadmin/admin who created it
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
}
